{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morphics Base Category",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "variants",
    "required_animations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^base\\.[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "planned"
      ],
      "description": "active = skeleton and animations exist or are being made"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "examples": {
            "type": "string"
          }
        }
      }
    },
    "skeleton": {
      "type": "string",
      "description": "Unreal asset path"
    },
    "required_animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
