{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morphics loot tables",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "entries"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^loot\\.[a-z0-9_.]+$"
      },
      "entries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "weight"
          ],
          "properties": {
            "item": {
              "type": "string",
              "pattern": "^item\\.[a-z0-9_]+\\.[a-z0-9_]+$"
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Percent chance of this item when the table is rolled. All weights in a table sum to 100. PLACEHOLDER numbers."
            }
          }
        }
      }
    }
  }
}
