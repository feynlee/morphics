{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morphics Form",
  "type": "object",
  "required": [
    "id",
    "name",
    "role",
    "rarity",
    "base",
    "base_stats",
    "skills",
    "default_skin",
    "unlock"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^form\\.[a-z0-9_]+$"
    },
    "name": {
      "type": "string"
    },
    "lore": {
      "type": "string"
    },
    "role": {
      "enum": [
        "Tank",
        "Striker",
        "Support",
        "Scout",
        "Controller"
      ]
    },
    "rarity": {
      "enum": [
        "Common",
        "Rare",
        "Epic",
        "Legendary"
      ]
    },
    "base_stats": {
      "type": "object",
      "required": [
        "hp",
        "speed",
        "power",
        "defense"
      ],
      "properties": {
        "hp": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "power": {
          "type": "number",
          "minimum": 0
        },
        "defense": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "passives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model": {
      "type": "string",
      "description": "Unreal asset path. Empty in M1."
    },
    "default_skin": {
      "type": "string",
      "description": "Skin id for the form's default look. Must be made for the form's base."
    },
    "unlock": {
      "type": "object",
      "required": [
        "type",
        "cost"
      ],
      "properties": {
        "type": {
          "enum": [
            "free",
            "earn",
            "buy",
            "pass",
            "event"
          ]
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "description": "For earn: the farming target (fragments or spectrum to collect)."
        },
        "skip": {
          "type": "object",
          "required": [
            "currency",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "currency": {
              "enum": [
                "spectrum",
                "prisms"
              ],
              "description": "spectrum = the soft currency of the item's own spectrum (set by its top-level body type), earned in play. prisms = premium currency (a mix of all spectrums), bought on Steam."
            },
            "amount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "description": "Price to skip farming. Required when type is earn. Starters may only use spectrum."
        }
      }
    },
    "base": {
      "type": "string",
      "pattern": "^base\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "A node in the body-type tree. Usually a subcategory. Sets skeleton and shared animations."
    },
    "extra_animations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Form-specific animations on top of the base set."
    },
    "starter": {
      "type": "boolean",
      "default": false,
      "description": "True if the player can inhabit this form as the first form (the opening). Starter forms are never sold. The one the player picks is granted in setup. The others are earned in play (unlock type earn)."
    }
  }
}
