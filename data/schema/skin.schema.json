{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morphics Skin (cosmetic only, made for one base)",
  "type": "object",
  "required": [
    "id",
    "base",
    "name",
    "look",
    "unlock"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^skin\\.[a-z0-9_.]+$"
    },
    "base": {
      "type": "string",
      "pattern": "^base\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Body-type node this skin is made for. It fits this node and all nodes below it. It never fits another branch."
    },
    "form_id": {
      "type": "string",
      "description": "Optional. Makes the skin exclusive to one form (for example its default look)."
    },
    "name": {
      "type": "string"
    },
    "look": {
      "type": "object"
    },
    "sfx_pack": {
      "type": "string"
    },
    "unlock": {
      "type": "object",
      "required": [
        "type",
        "cost"
      ],
      "properties": {
        "type": {
          "enum": [
            "free",
            "earn",
            "buy",
            "pass",
            "event"
          ]
        },
        "cost": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
