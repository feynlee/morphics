{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill point sources (earned only, never sold)",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "note": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "channel",
          "track",
          "awards",
          "requires_active_morph",
          "repeatable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(xp|quest)\\.[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "channel": {
            "enum": [
              "experience",
              "quest"
            ],
            "description": "The only two ways to get skill points. There is no purchase channel."
          },
          "repeatable": {
            "type": "boolean"
          },
          "track": {
            "enum": [
              "spirit",
              "morph"
            ],
            "description": "spirit = the player track (the spirit that inhabits any form). morph = the per-morph track."
          },
          "awards": {
            "enum": [
              "spirit_points",
              "morph_points"
            ],
            "description": "Must match the track: spirit gives spirit_points, morph gives morph_points."
          },
          "requires_active_morph": {
            "type": "boolean",
            "description": "True if the player must be playing the morph to earn this. Required for the morph track."
          }
        }
      }
    }
  }
}
